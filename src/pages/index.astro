            width={400}
            height={300}
          />
        </figure>
        <figure>
          <GalleryThumb
            name="Exterior Light Fixtures"
            alt="West Michigan exterior gooseneck lighting installation on a steel-sided pole building"
            sizes="(max-width: 600px) 95vw, 33vw"
            width={400}
