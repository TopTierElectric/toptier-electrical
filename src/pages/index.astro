---
import TTELayout from '~/layouts/TTELayout.astro';
import GalleryThumb from '~/components/GalleryThumb.astro';
import { Picture, getImage } from 'astro:assets';
import heroImage from '~/assets/images/Custom LED Fennville.webp';
import siteData from '~/data/site.json';

// Single 800w hero preload for all viewports. The old pair of
// media-scoped preloads (480w mobile / 800w desktop) double-fetched on
// modern phones: at DPR >= 2 the hero image's srcset math selects the
// 800w candidate while the preload had already pulled the 480w —
// Lighthouse showed both AVIFs downloading. One 800w preload matches
// the srcset choice on desktop (50vw ≈ 720px) and on 2x mobile
// (~100vw ≈ 820px), so the preloaded bytes are the render bytes.
const heroPreload = await getImage({
  src: heroImage,
  format: 'avif',
  width: 800,
  quality: 68,
});

const faqLd = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question","name": "Do you handle both residential and light commercial work?","acceptedAnswer": {"@type": "Answer","text": "Yes. We support homes and small business spaces across West Michigan with service work and planned upgrades."}},
    {"@type": "Question","name": "Can you help if I'm not sure what's causing the problem?","acceptedAnswer": {"@type": "Answer","text": "Absolutely. We start with troubleshooting, explain what we find, and outline the safest fix options."}},
    {"@type": "Question","name": "Do you install customer-supplied fixtures or EV chargers?","acceptedAnswer": {"@type": "Answer","text": "Yes, as long as the equipment is compatible with your electrical system and installed per manufacturer guidance."}},
    {"@type": "Question","name": "What areas do you serve?","acceptedAnswer": {"@type": "Answer","text": "We serve West Michigan, including Holland, Grand Rapids, Allegan, Zeeland, Saugatuck, Hudsonville, Byron Center, Muskegon, and Grand Haven. See full service areas at https://www.toptier-electrical.com/service-areas."}}
  ]
}`;

// Speakable directive: identifies which sections of the page are
// suitable for text-to-speech assistants (Google Assistant SGE, voice
// search). Targeting the H1 + hero subhead + trust strip means voice
// queries about the business return the most useful sentences, not
// navigation chrome or footer copy.
const speakableLd = `{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.toptier-electrical.com/#speakable",
  "url": "https://www.toptier-electrical.com/",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".hero-sub", ".trust-strip"]
  }
}`;

// HasOfferCatalog declares Carl's service catalog as a structured
// list of Offer items, each pointing at its service hub. Helps
// Google understand the full service surface and surface specific
// services in queries like "panel upgrade near me" or "EV charger
// installation Grand Rapids".
const offerCatalogLd = `{
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "@id": "https://www.toptier-electrical.com/#offer-catalog",
  "name": "Top Tier Electrical — Services",
  "itemListElement": [
    {"@type": "Offer","name": "Electrical Panel Upgrade","url": "https://www.toptier-electrical.com/panel-upgrades","itemOffered": {"@type": "Service","name": "Electrical Panel Upgrade","provider": {"@id": "https://www.toptier-electrical.com/#localbusiness"}}},
    {"@type": "Offer","name": "EV Charger Installation","url": "https://www.toptier-electrical.com/ev-chargers","itemOffered": {"@type": "Service","name": "Level 2 EV Charger Installation","provider": {"@id": "https://www.toptier-electrical.com/#localbusiness"}}},
    {"@type": "Offer","name": "Whole-Home Generator Installation","url": "https://www.toptier-electrical.com/generators","itemOffered": {"@type": "Service","name": "Whole-Home Generator Installation","provider": {"@id": "https://www.toptier-electrical.com/#localbusiness"}}},
    {"@type": "Offer","name": "Electrical Repairs","url": "https://www.toptier-electrical.com/electrical-repairs","itemOffered": {"@type": "Service","name": "Electrical Troubleshooting and Repair","provider": {"@id": "https://www.toptier-electrical.com/#localbusiness"}}},
    {"@type": "Offer","name": "Lighting Installation","url": "https://www.toptier-electrical.com/lighting","itemOffered": {"@type": "Service","name": "LED and Recessed Lighting Installation","provider": {"@id": "https://www.toptier-electrical.com/#localbusiness"}}},
    {"@type": "Offer","name": "Electrical Code Corrections","url": "https://www.toptier-electrical.com/code-corrections","itemOffered": {"@type": "Service","name": "NEC Code Corrections","provider": {"@id": "https://www.toptier-electrical.com/#localbusiness"}}},
    {"@type": "Offer","name": "Commercial Electrical","url": "https://www.toptier-electrical.com/commercial","itemOffered": {"@type": "Service","name": "Commercial Electrical Services","provider": {"@id": "https://www.toptier-electrical.com/#localbusiness"}}}
  ]
}`;
---

<TTELayout
  title="Electrician in Allegan & Grand Rapids | Top Tier Electrical"
  description="Owner-operated master electrician in Allegan serving Holland, Grand Rapids & West Michigan. 5.0★ on Google. Panel upgrades, EV chargers, repairs. (616) 334-7159."
  canonical="https://www.toptier-electrical.com/"
  ogImage="https://www.toptier-electrical.com/images/og/pages/home.png"
  jsonLd={[faqLd, speakableLd, offerCatalogLd]}
>
  <link slot="head" rel="preload" as="image" href={heroPreload.src} type="image/avif" fetchpriority="high" />
  <main id="main-content">
    <section class="hero">
      <div class="container hero-layout">
        <div class="hero-text">
          <div class="hero-label">Owner-Operated · Based in Allegan, MI</div>
          <h1>Licensed Master Electrician in Allegan, Grand Rapids &amp; West Michigan</h1>
          <p class="hero-sub">
            Clean electrical work, clear communication, realistic timelines. The master electrician who scopes your job
            is the same one who shows up and does it.
          </p>
          <div class="hero-cta">
            <a
              href="tel:+16163347159"
              class="btn btn-primary"
              data-cta="hero-call"
              data-ga-event="phone_click"
              data-ga-label="index__hero-phone"
              data-ga-destination="tel:+16163347159">&#128222; Call (616) 334-7159</a
            >
          </div>
          <p class="hero-alt-cta">
            Or <a
              href="/fast-estimate"
              data-ga-event="clear_estimate_click"
              data-ga-label="index__hero-fast-estimate"
              data-ga-destination="/fast-estimate">get a fast estimate</a
            > (30-second form) — or <a
              href="sms:+16163347159?body=Hi%20Carl%20-%20photo%20attached%20for%20a%20fast%20estimate."
              data-ga-event="text_panel_photo_click"
              data-ga-label="index__hero-sms"
              data-ga-destination="sms:+16163347159">text a photo of the job</a
            >.
          </p>
          <ul class="hero-trust" aria-label="Credentials and trust signals">
            <li>
              <a
                href={siteData.seo.googleBusinessProfileUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Read our ${siteData.seo.googleReviewCount} verified Google reviews`}
                >★ {siteData.seo.googleReviewAverage.toFixed(1)} from {siteData.seo.googleReviewCount} Google reviews</a
              >
            </li>
            <li>Master Electrician · MI License #6220430</li>
            <li>Insured · Owner-Operated</li>
            <li>Clear scope before work starts</li>
          </ul>
        </div>
        <div class="hero-image">
          <Picture
            class="hero-picture"
            src={heroImage}
            alt="Custom kitchen lighting by Top Tier Electrical in Fennville, MI — island pendants and toe-kick LED accent lighting"
            widths={[480, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            quality={68}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>
    <!-- Trust Strip -->
    <div class="trust-strip">
      <div class="container">
        <div class="trust-badges">
          <span class="badge">&#10004; Licensed &amp; Insured</span>
          <span class="badge">MI License #6220430</span>
          <span class="badge">&#128274; Code-aware workmanship</span>
          <span class="badge">&#127968; Owner-operated</span>
        </div>
      </div>
    </div>

    <section class="container" id="services">
      <h2>What Do You Need Help With?</h2>
