          />
        </figure>
        <figure>
          <GalleryThumb
            name="Interior LED Lighting"
            alt="New Buffalo, MI dispensary new-build interior LED lighting and tenant electrical fit-out"
            sizes="(max-width: 600px) 95vw, 33vw"
            width={400}
            height={300}
          />
        </figure>
        <figure>
          <GalleryThumb
            name="Electrical Panels"
            alt="Grand Rapids, MI commercial 400 amp electrical service and subpanel installation"
            sizes="(max-width: 600px) 95vw, 33vw"
            width={400}
            height={300}
          />
        </figure>
      </div>
      <p class="section-more">
        <a href="/gallery">See more West Michigan electrical projects →</a>
      </p>
    </section>

    <section class="container trust-section" id="about">
      <h2>Why Top Tier Electrical</h2>
      <div class="trust-grid">
        <article class="trust-item">
          <h3>Scope Clarity</h3>
          <p>Clear planning before work begins, so there are no surprises.</p>
        </article>
        <article class="trust-item">
