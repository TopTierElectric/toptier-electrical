    <section class="cta-section">
      <h2>Ready to Get Started?</h2>
      <p>
        Call <a href="tel:+16163347159" data-ga-event="phone_click" data-ga-label="index__phone">(616) 334-7159</a> or{
          ' '
        }
        <a
          href="sms:+16163347159?body=Hi%20Carl%20-%20photo%20attached%20for%20a%20fast%20estimate."
          data-ga-event="text_panel_photo_click"
          data-ga-label="index__cta-sms"
          data-ga-destination="sms:+16163347159">text a photo of the job</a
        > to the same number — or email{' '}
