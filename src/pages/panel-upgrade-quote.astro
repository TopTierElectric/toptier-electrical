---
import TTELayout from '~/layouts/TTELayout.astro';
import GalleryThumb from '~/components/GalleryThumb.astro';
import siteData from '~/data/site.json';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.toptier-electrical.com/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Electrical Panel Upgrade Quote',
      item: 'https://www.toptier-electrical.com/panel-upgrade-quote',
    },
  ],
});
---

<TTELayout
  title="200-Amp Electrical Panel Upgrade | Clear Quote"
  description="Upgrade to a safe 200-amp electrical panel, sized for the loads modern homes keep adding. Licensed Michigan master electrician, 5-star rated. Call (616) 334-7159."
  canonical="https://www.toptier-electrical.com/panel-upgrade-quote"
  ogImage="https://www.toptier-electrical.com/images/og/panel-upgrades.png"
  robots="noindex, follow"
  jsonLd={[breadcrumbLd]}
>
  <main id="main-content">
    <section class="hero lp-hero">
      <div class="container lp-hero-grid">
        <div class="lp-hero-copy">
          <h1>Upgrade to a Safe 200-Amp Electrical Panel — Ready for Everything You'll Add Next</h1>
          <p class="hero-sub">
            One clean install by a licensed Michigan master electrician. Homes keep adding load — an EV charger, a hot
            tub, an electric water heater — and the panel is where it all has to fit. We size yours with a real load
            calculation: clear scope, fair price, no pressure.
          </p>
          <div class="lp-trust-chips">
            <span class="badge">&#10004; Licensed &amp; Insured</span>
            <span class="badge">{siteData.business.license}</span>
            <span class="badge"
              >&#9733; {siteData.seo.googleReviewAverage.toFixed(1)} — {siteData.seo.googleReviewCount} Google reviews</span
            >
            <span class="badge">Owner-Operated Master Electrician</span>
          </div>
          <a
            class="btn btn-primary lp-call-btn"
            href="tel:+16163347159"
            data-ga-event="phone_click"
            data-ga-label="lp-panel__hero-call"
            data-ga-destination="tel:+16163347159"
          >
            &#128222; Tap to Call (616) 334-7159
          </a>
          <p class="cta-microcopy">Mon–Fri 8am–6pm · Sat 9am–1pm · Most quotes within one business day.</p>
        </div>
        <div class="lp-form-card">
          <h2>Get Your Clear Quote</h2>
          <p class="lp-form-lede">30 seconds. No spam, no pressure — just a straight answer on scope and price.</p>
          <form name="lp-panel" method="POST" action="/api/contact" novalidate data-enhanced-form class="lp-form">
            <input type="hidden" name="form_name" value="Ad Landing — Panel Upgrade Quote" />
            <input
              class="form-honeypot"
              type="text"
              name="_gotcha"
              aria-label="Leave this field blank"
              tabindex="-1"
              autocomplete="off"
            />
            <label for="lp-name">Name <span class="required-marker" aria-hidden="true">*</span></label>
            <input type="text" id="lp-name" name="name" required autocomplete="name" />
            <label for="lp-phone">Phone <span class="required-marker" aria-hidden="true">*</span></label>
            <input type="tel" id="lp-phone" name="phone" required autocomplete="tel" inputmode="tel" />
            <label for="lp-zip">Zip Code <span class="required-marker" aria-hidden="true">*</span></label>
            <input
              type="text"
              id="lp-zip"
              name="zip"
              required
              autocomplete="postal-code"
              inputmode="numeric"
              pattern="[0-9]{5}"
              maxlength="5"
            />
            <fieldset class="lp-service-choice">
              <legend>What's driving the upgrade?</legend>
              <label><input type="radio" name="service" value="Panel Upgrade" checked /> Panel upgrade</label>
              <label
                ><input type="radio" name="service" value="Panel Upgrade + New Load Circuit" /> Adding a big load (EV, hot
                tub…)</label
              >
              <label><input type="radio" name="service" value="Panel Upgrade — Not Sure Yet" /> Not sure yet</label>
            </fieldset>
            <button type="submit" data-cta="lp-panel-quote" data-submit-label="Get My Clear Quote">
              Get My Clear Quote
            </button>
            <p class="cta-microcopy">
              Licensed &amp; insured ({siteData.business.license}) · We call you back — usually within one business day.
            </p>
            <p class="form-status" data-form-status aria-live="polite"></p>
            <p class="form-fallback">
              If the form does not load, call (616) 334-7159 or email info@toptier-electrical.com.
            </p>
          </form>
        </div>
      </div>
    </section>

    <div class="trust-strip">
      <div class="container">
        <div class="trust-badges">
          <span class="badge">&#10004; Licensed &amp; Insured</span>
          <span class="badge">{siteData.business.license}</span>
          <span class="badge"
            >&#9733;&#9733;&#9733;&#9733;&#9733; {siteData.seo.googleReviewAverage.toFixed(1)} on Google</span
          >
          <span class="badge">Permits &amp; Inspection Included</span>
        </div>
      </div>
    </div>

    <section class="container section-pad">
      <h2>Why West Michigan Homes Are Outgrowing Their Panels</h2>
      <ul>
        <li>
          <strong>200 amp is the modern default.</strong> Most panels were sized for a different era. Central AC, an electric
          range and dryer — then the additions start: a hot tub, a heat pump, a tankless water heater, an EV in the garage.
          A 200-amp service runs it all with room for what's next.
        </li>
        <li>
          <strong>Aging panels are a safety issue on their own.</strong> No spare breaker slots, tandem breakers crammed
          into single spaces, corroded lugs — or a Federal Pacific or Zinsco panel that should be replaced regardless of
          size. An upgrade resets all of it, to current code.
        </li>
        <li>
          <strong>Sized by the numbers, not guesswork.</strong> We run a real load calculation (NEC Article 220) so you buy
          the capacity your home actually needs — nothing more.
        </li>
        <li>
          <strong>New circuits while the panel is open.</strong> If a new load is what prompted the call — EV charger, hot
          tub, water heater — we can run that dedicated circuit during the same visit, on the same permit, for meaningfully
          less than a separate project.
        </li>
        <li>
          <strong>Rebates handled.</strong> Holland BPW offers a $1,000 panel rebate, and utility programs like Consumers
          Energy's PowerMIDrive can credit related work — we point you at every dollar you qualify for.
        </li>
      </ul>
    </section>

    <section class="container section-pad-tight">
      <h2>Recent Panel Work</h2>
      <div class="proof-grid">
        <figure class="proof-card">
          <GalleryThumb
            name="Electrical panel replacement"
            alt="Square D Homeline 200 amp panel replacement with clean wire dress by Top Tier Electrical"
            sizes="(max-width: 600px) 95vw, 50vw"
            width={400}
            height={300}
          />
          <figcaption>200A panel replacement — clean wire dress, labeled circuits.</figcaption>
        </figure>
        <figure class="proof-card">
          <GalleryThumb
            name="Residential panel install"
            alt="Dorr, MI new-build residential install with Square D Homeline 200 amp main panel"
            sizes="(max-width: 600px) 95vw, 50vw"
            width={400}
            height={300}
          />
          <figcaption>Square D Homeline 200A — new-build install, Dorr MI.</figcaption>
        </figure>
      </div>
    </section>

    <section class="container section-pad">
      <h2>What Neighbors Say — Real Google Reviews</h2>
      <div class="lp-reviews">
        <blockquote>
          <p>
            "We needed an electric panel upgrade and he came over right away to give us a quote and worked with us on a
            date and what was needed to apply for permits. He kept us updated the entire time and was very upfront about
            everything… Pricing was very fair and communication was excellent."
          </p>
          <cite>— Kayley Maguire, electrical panel upgrade</cite>
        </blockquote>
        <blockquote>
          <p>
            "If we could give him 6 stars we would… he spent a lot of time with us during the estimate talking out all
            the potentials and was genuine and honest in what he suggested… Look no further, make the call."
          </p>
          <cite>— Andrew Daniels, electrical panel upgrade</cite>
        </blockquote>
      </div>
      <p>
        <strong
          >{siteData.seo.googleReviewAverage.toFixed(1)} stars across {siteData.seo.googleReviewCount} Google reviews</strong
        >
        — <a href="/reviews">read them all</a>.
      </p>
    </section>

    <section class="container section-pad-tight">
      <h2>How It Works</h2>
      <ol>
        <li><strong>Tell us what you need</strong> — the 30-second form above, or a quick call.</li>
        <li>
          <strong>Get a clear quote</strong> — scope, price, and rebate guidance, usually within one business day.
        </li>
        <li>
          <strong>One-day install</strong> — most 200-amp upgrades finish same-day, permit and inspection coordinated for
          you.
        </li>
      </ol>
    </section>

    <section class="container section-pad-tight">
      <h2>Straight Answers</h2>
      <div class="faq-list">
        <details>
          <summary>How long does a 100 → 200 amp upgrade take?</summary>
          <p>
            Typically 6–10 hours of work with a 2–4 hour power outage while the utility cuts and reconnects. Same-day
            completion in most cases.
          </p>
        </details>
        <details>
          <summary>Do I need a bigger panel to add an EV charger, hot tub, or electric water heater?</summary>
          <p>
            Not always — that's what the load calculation tells us. Homes with mostly gas appliances often have room for
            one big new load on 100-amp service; homes with electric heat, range, and dryer usually don't. We give you
            the real answer before you spend anything.
          </p>
        </details>
        <details>
          <summary>Is the permit included?</summary>
          <p>
            Yes. Permit pulling and inspection coordination are part of the quoted price — never a surprise line item.
          </p>
        </details>
        <details>
          <summary>Will my electric bill go up?</summary>
          <p>
            No. Service amperage doesn't change your rate — you pay for the energy you use, not the capacity available.
          </p>
        </details>
      </div>
    </section>

    <section class="cta-section">
      <h2>Ready for Safe, Modern Power?</h2>
      <p>
        Call <a href="tel:+16163347159" data-ga-event="phone_click" data-ga-label="lp-panel__footer-phone"
          >(616) 334-7159</a
        > or use the 30-second form above — we'll come back with a clear scope and price.
      </p>
      <a
        href="#lp-name"
        class="btn btn-primary"
        data-ga-event="clear_estimate_click"
        data-ga-label="lp-panel__footer-form"
      >
        Get My Clear Quote
      </a>
      <p class="cta-microcopy">
        Licensed &amp; insured ({siteData.business.license}) · Owner-operated · No-pressure quotes.
      </p>
    </section>
  </main>
</TTELayout>

<style>
  .lp-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
  }
  .lp-hero-copy {
    text-align: left;
  }
  .lp-form {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .lp-form label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-black);
    margin: 0.6rem 0 0.25rem;
  }
  .lp-form input[type='text'],
  .lp-form input[type='tel'] {
    padding: 0.65rem 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 1rem;
    color: var(--brand-black);
    background: #fff;
  }
  .lp-form input:focus {
    outline: 2px solid var(--brand-gold);
    outline-offset: 1px;
  }
  .lp-form button[type='submit'] {
    margin-top: 1rem;
    padding: 0.85rem 1.25rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--brand-black);
    background: var(--brand-gold);
    border: 1px solid var(--brand-gold-dark);
    border-radius: 8px;
    cursor: pointer;
  }
  .lp-form button[type='submit']:hover {
    background: var(--brand-gold-light);
  }
  .lp-form .cta-microcopy,
  .lp-form .form-fallback {
    color: var(--brand-slate);
  }
  .lp-trust-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  .lp-call-btn {
    font-size: 1.15rem;
    margin-top: 0.5rem;
  }
  .lp-form-card {
    background: #fff;
    color: var(--brand-black);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    box-shadow: var(--brand-shadow);
  }
  .lp-form-card h2 {
    margin: 0 0 0.25rem;
  }
  .lp-form-lede {
    color: var(--brand-slate);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }
  .lp-service-choice {
    border: none;
    padding: 0;
    margin: 0.75rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .lp-service-choice legend {
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .lp-service-choice label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.92rem;
  }
  .lp-reviews {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-bottom: 1rem;
  }
  .lp-reviews blockquote {
    background: var(--brand-ivory);
    border-left: 4px solid var(--brand-gold);
    border-radius: 0 8px 8px 0;
    margin: 0;
    padding: 1rem 1.25rem;
  }
  .lp-reviews cite {
    display: block;
    margin-top: 0.5rem;
    color: var(--brand-slate);
    font-style: normal;
    font-size: 0.88rem;
  }
  @media (max-width: 900px) {
    .lp-hero-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
