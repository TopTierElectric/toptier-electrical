---
import TTELayout from '~/layouts/TTELayout.astro';

export interface Props {
  city: string;
  slug: string;
  county?: string;
}

const { city, slug, county = `${city}, MI` } = Astro.props;
const canonical = `https://www.toptier-electrical.com/${slug}`;
const ogImage = `https://www.toptier-electrical.com/images/og/locations/${slug}.png`;
const hasDistinctCounty = county !== `${city}, MI`;
// Strip the trailing ", MI" from county for display so copy never
// renders the doubled state ("Zeeland, MI (Ottawa County, MI)").
const countyDisplay = county.replace(/, MI$/, '');
const description = hasDistinctCounty
  ? `Licensed master electrician in ${city}, MI (${countyDisplay}). Panel upgrades, EV chargers, lighting, repairs. Call (616) 334-7159.`
  : `Licensed master electrician for ${city}, MI homes and businesses. Panel upgrades, EV chargers, lighting, repairs. Call (616) 334-7159.`;
// Proximity-based nearby-city links. Every city page links 5 real
// neighbors, which also guarantees every city page (including the
// newer ones) has inbound internal links — GSC showed 12 pages stuck
// in "Discovered/Crawled — currently not indexed", matching the 9
// pages that previously had zero internal links anywhere.
const CITY_SLUGS: Record<string, string> = {
  Holland: '/electrician-holland-mi',
  'Grand Rapids': '/electrician-grand-rapids-mi',
  Allegan: '/electrician-allegan-mi',
  Zeeland: '/electrician-zeeland-mi',
  Hudsonville: '/electrician-hudsonville-mi',
  Ada: '/electrician-ada-mi',
  'Byron Center': '/electrician-byron-center-mi',
  Saugatuck: '/electrician-saugatuck-mi',
  Douglas: '/electrician-douglas-mi',
  Jamestown: '/electrician-jamestown-mi',
  'Grand Haven': '/electrician-grand-haven',
  Muskegon: '/electrician-muskegon',
  Plainwell: '/electrician-plainwell-mi',
  Caledonia: '/electrician-caledonia-mi',
  Wayland: '/electrician-wayland-mi',
  Fennville: '/electrician-fennville-mi',
  Hopkins: '/electrician-hopkins-mi',
  Jenison: '/electrician-jenison-mi',
  Alto: '/electrician-alto-mi',
  'Comstock Park': '/electrician-comstock-park-mi',
  'Forest Hills': '/electrician-forest-hills-mi',
};
const NEARBY: Record<string, string[]> = {
  Allegan: ['Plainwell', 'Wayland', 'Hopkins', 'Fennville', 'Holland'],
  Holland: ['Zeeland', 'Fennville', 'Saugatuck', 'Hudsonville', 'Grand Haven'],
  Zeeland: ['Holland', 'Hudsonville', 'Jenison', 'Byron Center', 'Allegan'],
  'Grand Rapids': ['Forest Hills', 'Comstock Park', 'Jenison', 'Byron Center', 'Ada'],
  Hudsonville: ['Jenison', 'Zeeland', 'Byron Center', 'Jamestown', 'Grand Rapids'],
  Ada: ['Forest Hills', 'Grand Rapids', 'Caledonia', 'Alto', 'Comstock Park'],
  'Byron Center': ['Caledonia', 'Grand Rapids', 'Hudsonville', 'Jenison', 'Wayland'],
  Saugatuck: ['Douglas', 'Fennville', 'Holland', 'Allegan', 'Zeeland'],
  Douglas: ['Saugatuck', 'Fennville', 'Holland', 'Allegan', 'Zeeland'],
  Jamestown: ['Hudsonville', 'Jenison', 'Zeeland', 'Byron Center', 'Grand Rapids'],
  'Grand Haven': ['Muskegon', 'Holland', 'Zeeland', 'Hudsonville', 'Grand Rapids'],
  Muskegon: ['Grand Haven', 'Holland', 'Grand Rapids', 'Zeeland', 'Hudsonville'],
  Fennville: ['Saugatuck', 'Douglas', 'Allegan', 'Holland', 'Hopkins'],
  Hopkins: ['Wayland', 'Allegan', 'Plainwell', 'Byron Center', 'Caledonia'],
  Wayland: ['Hopkins', 'Caledonia', 'Byron Center', 'Allegan', 'Plainwell'],
  Plainwell: ['Allegan', 'Wayland', 'Hopkins', 'Fennville', 'Caledonia'],
  Alto: ['Caledonia', 'Ada', 'Forest Hills', 'Byron Center', 'Grand Rapids'],
  Caledonia: ['Alto', 'Byron Center', 'Ada', 'Wayland', 'Grand Rapids'],
  'Comstock Park': ['Grand Rapids', 'Forest Hills', 'Ada', 'Jenison', 'Byron Center'],
  'Forest Hills': ['Ada', 'Grand Rapids', 'Alto', 'Caledonia', 'Comstock Park'],
  Jenison: ['Hudsonville', 'Grand Rapids', 'Zeeland', 'Comstock Park', 'Byron Center'],
};
const nearbyAreas = (NEARBY[city] ?? ['Holland', 'Grand Rapids', 'Allegan', 'Zeeland', 'Hudsonville'])
  .filter((c) => c !== city && CITY_SLUGS[c])
  .map((c) => ({ city: c, href: CITY_SLUGS[c] }));

// Explicit 3-level BreadcrumbList: Home → Service Areas → {City}.
// Without this, TTELayout's auto-generated breadcrumb falls back to
// 2 levels (Home → URL-segment-titleized) which misses the
// 'Service Areas' parent and reads awkwardly ('Electrician Holland
// Mi' rather than 'Electrician in Holland, MI').
const breadcrumbItems = [
  { name: 'Home', item: 'https://www.toptier-electrical.com/' },
  { name: 'Service Areas', item: 'https://www.toptier-electrical.com/service-areas' },
  { name: `Electrician in ${city}, MI`, item: canonical },
];
---

<TTELayout
  title={`Electrician in ${city}, MI | Top Tier Electrical`}
  {description}
  canonical={canonical}
  {ogImage}
  {breadcrumbItems}
>
  <main id="main-content">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/service-areas">Service Areas</a></li>
        <li aria-current="page">Electrician in {city}, MI</li>
      </ol>
    </nav>
    <section class="hero">
      <div class="hero-content">
        <h1>Master Electrician in {city}, MI</h1>
        <p>Licensed master electrician serving {city} homes and commercial spaces. MI License #6220430.</p>
        <a
          href="tel:+16163347159"
          class="btn btn-primary"
          data-ga-event="phone_click"
          data-ga-label={`${slug}__hero-phone`}
          data-ga-destination="tel:+16163347159">&#128222; Call (616) 334-7159</a
        >
        <p class="hero-alt-cta">
          Or <a href="/fast-estimate" data-ga-event="clear_estimate_click" data-ga-label={`${slug}__hero-fast-estimate`}
            >get a fast estimate</a
          > (30-second form) — or <a
            href="sms:+16163347159?body=Hi%20Carl%20-%20photo%20attached%20for%20a%20fast%20estimate."
            data-ga-event="text_panel_photo_click"
            data-ga-label={`${slug}__hero-sms`}>text a photo of the job</a
          >.
        </p>
      </div>
    </section>
    <div class="trust-strip">
      <div class="container">
        <div class="trust-badges">
          <span class="badge">&#10004; Licensed &amp; Insured</span>
          <span class="badge">MI License #6220430</span>
          <span class="badge">&#127968; Owner-Operated</span>
        </div>
      </div>
    </div>
    <section class="services">
      <div class="container">
        <h2>{city} Service Coverage</h2>
        <p>
          Panel upgrades, EV charger installations, lighting projects, and electrical repairs for {countyDisplay} and surrounding
          areas.
        </p>
        <h3>Services Available in {city}</h3>
        <ul>
          <li><a href="/panel-upgrades">Electrical panel upgrades</a></li>
          <li><a href="/ev-chargers">EV charger installation</a></li>
          <li><a href="/lighting">Lighting and fixtures</a></li>
          <li><a href="/electrical-repairs">Electrical repairs and troubleshooting</a></li>
          <li><a href="/generators">Generator installation</a></li>
          <li><a href="/energy-solutions">Energy solutions</a></li>
        </ul>
        <p><a href="/contact" class="btn btn-secondary">Confirm availability in {city}</a></p>
      </div>
    </section>
    <section class="services">
      <div class="container">
        <h2>Nearby Service Areas</h2>
        <p>
          Looking for electrical help in a nearby city? Explore nearby service area pages or view our full West Michigan
          coverage map.
        </p>
        <ul>
          {
            nearbyAreas.slice(0, 4).map((area) => (
              <li>
                <a href={area.href}>Electrician in {area.city}, MI</a>
              </li>
            ))
          }
          <li><a href="/service-areas">View all service areas</a></li>
        </ul>
      </div>
    </section>
    <slot />
    <section class="container section-pad">
      <h2>Common Questions in {city}</h2>
      <p>Deeper reading on the questions {city} homeowners and business owners ask most:</p>
      <ul>
        <li>
          <a href="/blog/burning-smell-from-outlet">Burning smell from an outlet: what to do in the next 5 minutes</a>
        </li>
        <li>
          <a href="/blog/flickering-lights-when-to-worry"
            >Flickering lights: when it's annoying vs when it's an emergency</a
          >
        </li>
        <li><a href="/blog/100-amp-vs-200-amp-panel">100 amp vs 200 amp panel: which does your home need?</a></li>
        <li><a href="/blog/zinsco-fpe-panel-replacement">Zinsco and Federal Pacific panels: why they need to go</a></li>
        <li><a href="/blog/michigan-ev-charger-rebates">Michigan EV charger rebates & utility programs (2026)</a></li>
        <li>
          <a href="/blog/how-to-size-a-whole-home-generator">How to size a whole-home generator for a Michigan home</a>
        </li>
      </ul>
    </section>
    <section class="cta-section">
      <h2>Schedule Service in {city}</h2>
      <p>
        Call <a href="tel:+16163347159" data-ga-event="phone_click" data-ga-label="LocationServicePage__phone"
          >(616) 334-7159</a
        > or email <a href="mailto:info@toptier-electrical.com">info@toptier-electrical.com</a> to confirm scope and scheduling.
      </p>
      <a
        href="/booking"
        class="btn btn-primary"
        data-ga-event="clear_estimate_click"
        data-ga-label="Get a Clear Estimate"
        data-ga-destination="/booking">Get a Clear Estimate</a
      >
    </section>
  </main>
</TTELayout>
